# ---------------------------------------------------------------- Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only — never expose to the browser. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------- App
# Absolute base URL. Used for seller links, QR codes and payment return URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------- Payments
# mock | vipps
PAYMENT_PROVIDER=mock

# Vipps ePayment — only needed when PAYMENT_PROVIDER=vipps
VIPPS_API_BASE_URL=https://apitest.vipps.no
VIPPS_CLIENT_ID=
VIPPS_CLIENT_SECRET=
VIPPS_SUBSCRIPTION_KEY=
VIPPS_MERCHANT_SERIAL_NUMBER=
VIPPS_WEBHOOK_SECRET=

# ---------------------------------------------------------------- Seed
DEMO_PASSWORD=sorkyst2026
