# Supabase — optional in this phase.
# Without these the public site still works; enquiries from "Start en dugnad"
# are written to .data/leads.json instead of the database.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only. Used by the /api/leads route so it can insert without
# exposing a key to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Merk: uten disse kjører appen på demodata i src/lib/data/demo/ og lagrer
# bestillinger og forespørsler i .data/. Bestillingsskriving mot Supabase
# krever SUPABASE_SERVICE_ROLE_KEY.
