# Supabase — optional in this phase.
# Without these the public site still works; enquiries from "Start en dugnad"
# are written to .data/leads.json instead of the database.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only. Used by the /api/leads route so it can insert without
# exposing a key to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Merk: uten disse kjører appen på demodata i src/lib/data/demo/ og lagrer
# bestillinger og forespørsler i .data/. Bestillingsskriving mot Supabase
# krever SUPABASE_SERVICE_ROLE_KEY.

# Varsling når en bestilling kommer inn. Uten disse lagres ordren som normalt,
# men ingen får beskjed — det logges i stedet.
#
# E-post via Resend (resend.com). Uten et verifisert domene leverer Resend kun
# til e-postadressen kontoen er registrert på, som holder for interne varsler.
RESEND_API_KEY=
ORDER_NOTIFICATION_EMAIL=
# Valgfri avsender. Krever verifisert domene i Resend.
ORDER_NOTIFICATION_FROM=

# Alternativ eller tillegg: Slack innkommende webhook.
SLACK_WEBHOOK_URL=
