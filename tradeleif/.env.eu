# Ingen hemmeligheter her. Alpaca-nøkler ligger som Windows-brukervariabler (setup_eu.ps1). Claude brukes via ditt abonnement (Claude Code), ingen API-nøkkel.
# BROKER: alpaca = Alpaca PAPER (US-børs) | ibkr = IBKR paper via IB Gateway | localsim = LOKAL SIMULERING
#
# --- STEG 1 (nå): europeiske selskaper via US-noterte ADR-er på Alpaca paper ---
BROKER=alpaca
EXCHANGE_CALENDAR=XNYS
CURRENCY=USD
SYMBOLS=EQNR,SAP,ASML,NVO,SHEL,TTE
ALPACA_FEED=iex
#
# --- STEG 2 (senere): Oslo Børs via IBKR paper. Kommenter ut steg 1 og fjern # under ---
# BROKER=ibkr
# EXCHANGE_CALENDAR=XOSL
# CURRENCY=NOK
# IB_PRIMARY_EXCHANGE=OSE
# SYMBOLS=EQNR,DNB,NHY,TEL,ORK,MOWI
# IB_PORT=4002
# IB_HOST=127.0.0.1
# IB_CLIENT_ID=17
# IB_ACCOUNT=
#
# --- Felles ---
# ANALYST: claude_code = ditt Claude-abonnement via Claude Code (ingen API-kostnad)
#          rules = regelbasert uten AI | api = Anthropic API (egen fakturering)
ANALYST=claude_code
CLAUDE_CODE_MODEL=sonnet
CLAUDE_MODEL=claude-sonnet-5-5
INTERVAL_MIN=5
MAX_ORDER_VALUE=25000
MAX_POSITION_VALUE=50000
MAX_TOTAL_EXPOSURE=100000
MAX_ORDERS_PER_SYMBOL_DAY=1000
MAX_ORDERS_DAY=1000
DAILY_LOSS_LIMIT=100000
COOLDOWN_MIN=0
MIN_CONFIDENCE=0.3
NO_NEW_BUYS_BEFORE_CLOSE_MIN=0
LIMIT_SLIPPAGE=0.003
FILL_TIMEOUT_S=60
DB_PATH=data/eu_trader.db
DASHBOARD_PORT=8765
ALLOW_SHORT=1
