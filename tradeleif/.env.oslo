# Oslo Børs PAPER via lokal simulering (Yahoo, forsinket ~15 min). Ingen megler, ingen ekte penger.
# Ingen egne grenser (brukerens ønske): begrenset kun av kontanter (ingen belåning, ingen short).
BROKER=localsim
EXCHANGE_CALENDAR=XOSL
CURRENCY=NOK
YAHOO_SUFFIX=.OL
SYMBOLS=HUNT,OET,FRO,HAFNI,CAPT,CMBTO,NAPA,BORR,HSHP,TGS
SIM_START_CASH=20000
SIM_FEE_PCT=0.0005
SIM_MIN_FEE=49
SIM_SLIPPAGE=0.002
ANALYST=claude_code
INTERVAL_MIN=5
MAX_ORDER_VALUE=1000000
MAX_POSITION_VALUE=1000000
MAX_TOTAL_EXPOSURE=1000000
MAX_ORDERS_PER_SYMBOL_DAY=1000
MAX_ORDERS_DAY=1000
DAILY_LOSS_LIMIT=1000000
COOLDOWN_MIN=0
MIN_CONFIDENCE=0.3
NO_NEW_BUYS_BEFORE_CLOSE_MIN=0
ALLOW_SHORT=0
LIMIT_SLIPPAGE=0.003
DB_PATH=data/oslo_sim.db
